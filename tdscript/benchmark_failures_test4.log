fun main() {
    val host = "127.0.0.1"
    var temperature: Int = 0
    var pumpStatus: Int = 0
    
    // Feed watchdog timer initially
    WATCHDOG.feed()
    
    // Run control loop for demonstration (5 iterations)
    for (i in 1..5) {
        // Read temperature from register 100
        temperature = PLC.modbusRead(host, 100)
        
        // Read pump status from register 101
        pumpStatus = PLC.modbusRead(host, 101)
        
        // Control logic: If temperature > 250, turn pump OFF
        if (temperature > 250) {
            println("Temperature: $temperature°C - Turning pump OFF")
            PLC.modbusWrite(host, 101, 0)
        } else {
            println("Temperature: $temperature°C - Pump ON (status: $pumpStatus)")
            PLC.modbusWrite(host, 101, 1)
        }
        
        // Feed watchdog timer
        WATCHDOG.feed()
        
        // Optional: Network health check
        NET.ping(host)
        
        // Small delay simulation
        Thread.sleep(100)
    }
    
    // Final status report
    println("\n--- Final Status ---")
    println("Last Temperature: $temperature°C")
    println("Pump Status: ${if (temperature > 250) "OFF" else "ON"}")
    
    // Exit cleanly
    println("Control sequence completed successfully")
}
