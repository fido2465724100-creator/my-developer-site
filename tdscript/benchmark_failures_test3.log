from mock_hw import I2C, PLC, WATCHDOG, NET, BT

def main():
    # Initialize hardware
    i2c = I2C()
    plc = PLC()
    watchdog = WATCHDOG()
    net = NET()
    bt = BT()
    
    # Feed watchdog
    watchdog.feed()
    
    # I2C operations - strictly on 0x76
    try:
        # Read from valid I2C address 0x76
        data = i2c.read(0x76, 0, 8)
        print(f"I2C Read from 0x76: {data}")
        
        # Write to valid I2C address 0x76
        i2c.write(0x76, 0, [0x01, 0x02, 0x03])
        print("I2C Write to 0x76 successful")
    except Exception as e:
        print(f"I2C Error: {e}")
    
    # Modbus operations - strictly registers 100-200
    try:
        # Read from valid Modbus register
        val = plc.modbus_read("192.168.1.100", 150)
        print(f"Modbus Read from 150: {val}")
        
        # Write to valid Modbus register
        plc.modbus_write("192.168.1.100", 175, 255)
        print("Modbus Write to 175 successful")
    except Exception as e:
        print(f"Modbus Error: {e}")
    
    # Self-repair: Attempt forbidden I2C address 0x68, catch and repair
    try:
        i2c.read(0x68, 0, 8)  # Forbidden address
    except Exception:
        print("Self-repair: Forbidden I2C address 0x68 detected, using 0x76 instead")
        data = i2c.read(0x76, 0, 8)
        print(f"Repaired I2C Read from 0x76: {data}")
    
    # Self-repair: Attempt forbidden Modbus register 250, catch and repair
    try:
        plc.modbus_read("192.168.1.100", 250)  # Forbidden register
    except Exception:
        print("Self-repair: Forbidden Modbus register 250 detected, using 150 instead")
        val = plc.modbus_read("192.168.1.100", 150)
        print(f"Repaired Modbus Read from 150: {val}")
    
    # Network operations
    ping_time = net.ping("192.168.1.100")
    print(f"Network ping to 192.168.1.100: {ping_time:.3f}s")
    
    # Bluetooth operations
    bt.connect("BT-Device-001")
    bt.send("Hello, device!")
    response = bt.read_line()
    print(f"Bluetooth response: {response}")
    
    # Final watchdog feed
    watchdog.feed()
    
    print("Task completed successfully within CapabilityScope")

