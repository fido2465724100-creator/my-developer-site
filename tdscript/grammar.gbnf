# TDscript Core 1.1 GBNF Grammar for llama.cpp / Ollama / LM Studio
# Constrained decoding grammar ensuring 100% syntactically valid TDscript scripts

root ::= (language-directive)? ws (statement)* ws

language-directive ::= (("language:" | "язык:" | "мова:" | "sprache:") ws [a-zA-Z_\-]+ ws (";")?) ws

statement ::= (let-statement | var-statement | if-statement | while-statement | break-statement | continue-statement | expr-statement | block) ws

let-statement ::= ("let" | "пусть" | "нехай" | "sei" | "sea") ws identifier ws "=" ws expr (";" | "\n")
var-statement ::= ("var" | "переменная" | "змінна" | "variable" | "перем") ws identifier ws "=" ws expr (";" | "\n")

if-statement ::= ("if" | "если" | "якщо" | "wenn" | "si") ws "(" ws expr ws ")" ws statement (ws ("else" | "иначе" | "інакше" | "sonst" | "sino") ws statement)?
while-statement ::= ("while" | "пока" | "поки" | "solange" | "mientras") ws "(" ws expr ws ")" ws statement
break-statement ::= ("break" | "прервать" | "перервати" | "abbrechen") (";" | "\n")
continue-statement ::= ("continue" | "продолжить" | "продовжити" | "fortsetzen") (";" | "\n")

expr-statement ::= (assignment | call-expr) (";" | "\n")

assignment ::= identifier ws ("=" | "+=" | "-=" | "*=" | "/=") ws expr

block ::= "{" ws (statement)* ws "}"

expr ::= logic-or-expr

logic-or-expr ::= logic-and-expr (ws ("||" | "or" | "или") ws logic-and-expr)*
logic-and-expr ::= equality-expr (ws ("&&" | "and" | "и") ws equality-expr)*
equality-expr ::= relational-expr (ws ("==" | "!=") ws relational-expr)*
relational-expr ::= additive-expr (ws ("<" | "<=" | ">" | ">=") ws additive-expr)*
additive-expr ::= multiplicative-expr (ws ("+" | "-") ws multiplicative-expr)*
multiplicative-expr ::= unary-expr (ws ("*" | "/" | "%") ws unary-expr)*

unary-expr ::= ("!" | "-" | "+")? ws primary-expr

primary-expr ::= hex-literal | float-literal | int-literal | lstring-literal | string-literal | bool-literal | null-literal | call-expr | identifier | "(" ws expr ws ")"

call-expr ::= subsystem-call | print-call | generic-call

subsystem-call ::= ("I2C" | "PLC" | "WATCHDOG" | "NET" | "BT" | "BLE" | "SERIAL" | "HOST" | "ROBOT") "." identifier "(" ws (arg-list)? ws ")"
print-call ::= ("print" | "печать" | "друк" | "drucken") "(" ws (arg-list)? ws ")"
generic-call ::= identifier "(" ws (arg-list)? ws ")"

arg-list ::= expr (ws "," ws expr)*

# Literals
hex-literal ::= "0x" [0-9a-fA-F]+ ("L" | "l")?
float-literal ::= [0-9]+ "." [0-9]+
int-literal ::= [0-9]+ ("L" | "l")?

string-literal ::= "\"" ([^"\\\n\r] | "\\" [^\n\r])* "\"" | "'" ([^'\\\n\r] | "\\" [^\n\r])* "'"
lstring-literal ::= "L\"" ([^"\\\n\r] | "\\" [^\n\r])* "\"" | "L'" ([^'\\\n\r] | "\\" [^\n\r])* "'"

bool-literal ::= "true" | "false" | "истина" | "ложь" | "правда" | "хиба" | "wahr" | "falsch" | "verdadero" | "falso"
null-literal ::= "null" | "пусто" | "nichts" | "nulo"

identifier ::= [a-zA-Z_] [a-zA-Z0-9_]*

ws ::= ([ \t\n\r] | comment)*
comment ::= "//" [^\n]* | "#" [^\n]* | "/*" ([^*] | "*" [^/])* "*/"
